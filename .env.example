# SQL Arcade — Environment Variables Template
# Add these variables to your Vercel Project Settings -> Environment Variables

# OpenRouter AI Provider Configuration
VITE_OPENROUTER_API_KEY=your_openrouter_api_key_here
VITE_OPENROUTER_MODEL=openai/gpt-4o-mini
VITE_AI_PROVIDER=openrouter

# Google Gemini Direct (Alternative Provider)
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# Neon PostgreSQL Database Connection String (Serverless)
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
VITE_DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
